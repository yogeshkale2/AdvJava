package JDBC_PreparedStatement;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;


public class PreparedStatementExample {

	public static void main(String[] args) {
		String url = "jdbc:mysql://localhost:3306/classicmodels";
	    String username = "root";
	    String password = "root";
	    
	    // FIX 1 & 2: Remove single quotes around '?', and add a '?' for studentid
	    String sql = "UPDATE javaclass SET studentname = ? WHERE studentid = ?";
	    
	    // try-with-resources automatically closes both con and stm
	    try (Connection con = DriverManager.getConnection(url, username, password);
	         PreparedStatement stm = con.prepareStatement(sql)) 
	    {
	        // Now there are exactly two '?' placeholders, so these two lines work perfectly
	        stm.setString(1, "Professor"); 
	        stm.setInt(2, 1);
	        
	        int rowsUpdated = stm.executeUpdate();
	        System.out.println("Rows updated: " + rowsUpdated);
	        
	        // FIX 3: con.close() removed
	        
	    } catch(Exception e) {
	        e.printStackTrace();
	    }	
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
