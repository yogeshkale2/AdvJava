package JDBC_PreparedStatement;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;

import com.mysql.cj.xdevapi.PreparableStatement;

public class PreparedStatementExample {

	public static void main(String[] args) {
		String url = "jdbc:mysql://localhost:3306/classicmodels";
		String username = "root";
		String password = "root";
		
		String insertQuery = "INSERT INTO javaclass (studentid, studentname, salary) VALUES (?, ?, ?)";
		
		try (
			    Connection con = DriverManager.getConnection(url, username, password);
			    PreparedStatement stm = con.prepareStatement(insertQuery);
			) {
			
			stm.setInt(1,112);
			stm.setString(2,"Tokiyo");
			stm.setDouble(3, 700000.00);
			
			int rowsAffected = stm.executeUpdate();
			System.out.println("Insert rows successfully Affected : "+ rowsAffected);
			
			
		
		}catch (Exception  e) {
			    e.printStackTrace();
			}
	}
}


	


